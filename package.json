{
  "name": "second-brain",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.0-alpha.1",
  "homepage": "https://github.com/zulucode-design/second-brain",
  "repository": "https://github.com/zulucode-design/second-brain.git",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "node scripts/test-rust.mjs",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "verify": "pnpm check && pnpm test && pnpm test:rust && pnpm lint:rust && pnpm build",
    "sidecar:prepare": "node scripts/prepare-syncthing.mjs",
    "alpha:harness": "node scripts/alpha-harness.mjs sync",
    "tauri": "tauri",
    "tauri:dev": "pnpm sidecar:prepare && tauri dev --config src-tauri/tauri.sidecar.conf.json",
    "tauri:build": "pnpm sidecar:prepare && tauri build --config src-tauri/tauri.sidecar.conf.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "26.2.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "webdriverio": "^9.32.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-details": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.47",
    "lowlight": "^3.3.0",
    "markdown-it": "^14.3.3",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.17.2"
  }
}
